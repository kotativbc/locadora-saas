# Copie este arquivo para ".env" (na raiz, ao lado do docker-compose.yml) e
# preencha com valores reais. NUNCA comite o ".env" de verdade no Git —
# ele já está no .gitignore.

# --- Banco de dados ---
POSTGRES_USER=rental_app
# Gere uma senha forte, ex: openssl rand -base64 24
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=rental_saas

# --- API ---
# Gere um segredo forte, ex: openssl rand -base64 48
JWT_SECRET=troque-este-segredo

# Cookie de sessão só pode ser "Secure" quando o site estiver em HTTPS de
# verdade (domínio + Let's Encrypt). Em modo IP/sem domínio, deixe "false" —
# um cookie Secure sobre HTTP simplesmente não funciona. Troque pra "true"
# só depois de apontar o domínio e confirmar que o HTTPS está ativo.
COOKIE_SECURE=false

# --- Seed (usado só quando você rodar "npm run seed" manualmente) ---
SEED_SUPER_ADMIN_EMAIL=admin@soucore.com.br
SEED_SUPER_ADMIN_PASSWORD=troque-esta-senha-tambem

# --- Permissões de arquivo ---
# UID/GID do usuário "deploy" no servidor — descubra rodando "id -u" e "id -g"
# como o próprio deploy. Faz o usuário dentro do container nascer com o mesmo
# dono dos arquivos que o host cria, resolvendo o problema de permissão em
# /srv/rental-data e apps/api/prisma de uma vez por todas.
DEPLOY_UID=1000
DEPLOY_GID=1000

# --- E-mail (opcional) ---
# Se SMTP_HOST não estiver preenchido, o sistema usa um adaptador que só
# registra no log — nada quebra, mas "esqueci minha senha" não manda e-mail
# de verdade. Preencha com os dados da conta de e-mail já criada no
# DirectAdmin (Manutenção do site → E-mail Accounts → dados de SMTP).
# SMTP_HOST=mail.kotati.com.br
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=admin@kotati.com.br
# SMTP_PASS=a-senha-dessa-caixa-de-email
# SMTP_FROM=admin@kotati.com.br

# URL pública onde o site está servido — usada pra montar o link que vai no
# e-mail de redefinição de senha. Sem isso, o link no e-mail fica quebrado.
PUBLIC_APP_URL=https://rentovix.kotati.com.br

# Pra onde mandar alerta de monitoramento (disco, RAM, load, certificado).
# Se não preencher, usa o próprio SMTP_USER como destinatário.
# MONITOR_ALERT_EMAIL=admin@kotati.com.br
