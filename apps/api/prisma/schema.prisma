generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Empresa locadora cadastrada na plataforma (tenant).
model Company {
  id          String   @id @default(uuid())
  name        String
  tradeName   String?
  cnpj        String?  @unique
  logoPath    String? // caminho relativo dentro de /srv/rental-data/uploads, nunca uma URL pública direta
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users     User[]
  auditLogs AuditLog[]

  @@map("companies")
}

/// Usuário da plataforma. companyId nulo = usuário da plataforma (Super Admin).
model User {
  id           String    @id @default(uuid())
  companyId    String?
  company      Company?  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name         String
  email        String    @unique
  passwordHash String
  active       Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  lastLoginAt  DateTime?

  roles         UserRole[]
  refreshTokens RefreshToken[]
  auditLogs     AuditLog[]

  @@index([companyId])
  @@map("users")
}

/// Papel (role) do sistema. Papéis do sistema (SUPER_ADMIN etc.) têm companyId nulo.
model Role {
  id        String   @id @default(uuid())
  code      String   @unique // SUPER_ADMIN, COMPANY_ADMIN, FLEET_MANAGER, AGENT, FINANCE, CLIENT
  name      String
  createdAt DateTime @default(now())

  permissions RolePermission[]
  users       UserRole[]

  @@map("roles")
}

/// Permissão granular usada pelos guards da API.
model Permission {
  id   String @id @default(uuid())
  code String @unique // ex: companies.manage, fleet.manage, finance.manage
  description String

  roles RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model UserRole {
  userId String
  roleId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}

/// Refresh tokens de sessão. O valor em si nunca é armazenado, só o hash.
model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@map("refresh_tokens")
}

/// Trilha de auditoria — toda ação sensível (login, criação de empresa, mudança de permissão etc.) gera um registro.
model AuditLog {
  id         String   @id @default(uuid())
  companyId  String?
  company    Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action     String // ex: auth.login, company.create, user.create
  entityType String?
  entityId   String?
  metadata   Json?
  ip         String?
  createdAt  DateTime @default(now())

  @@index([companyId])
  @@index([userId])
  @@index([action])
  @@map("audit_logs")
}

/// Fila de jobs assíncronos. Processada por um worker CLI acionado via systemd timer (sem Redis).
model Job {
  id          String    @id @default(uuid())
  type        String
  payload     Json
  status      String    @default("pending") // pending | processing | done | failed
  attempts    Int       @default(0)
  lastError   String?
  runAfter    DateTime  @default(now())
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([status, runAfter])
  @@map("jobs")
}
