generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Empresa locadora cadastrada na plataforma (tenant).
model Company {
  id           String   @id @default(uuid())
  name         String
  tradeName    String?
  cnpj         String?  @unique
  logoPath     String? // caminho relativo dentro de /srv/rental-data/uploads, nunca uma URL pública direta
  status       String   @default("active") // pending | trial | active | past_due | suspended | cancelled | archived | security_blocked
  statusReason String? // motivo do estado atual (obrigatório ao suspender/cancelar/bloquear)
  planId       String?
  plan         Plan?    @relation(fields: [planId], references: [id], onDelete: SetNull)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Endereço — usado no cabeçalho dos contratos e como Foro (cidade/estado)
  // nas cláusulas de eleição de foro. Tudo opcional pra não travar quem já
  // tem empresa cadastrada sem esses dados.
  addressStreet       String?
  addressNumber       String?
  addressComplement   String?
  addressNeighborhood String?
  addressCity         String?
  addressState        String? // sigla, ex: SP, MG
  addressZipCode      String?

  users     User[]
  auditLogs AuditLog[]
  vehicles  Vehicle[]
  customers Customer[]
  documents Document[]
  ratePlans RatePlan[]
  contracts Contract[]
  inspections   Inspection[]
  damages       Damage[]
  maintenances  Maintenance[]
  claims        Claim[]
  fines         Fine[]
  vehiclePositions VehiclePosition[]
  charges       Charge[]
  expenses      Expense[]
  statusEvents  CompanyStatusEvent[]

  @@map("companies")
}

/// Plano da plataforma — limites centralizados aqui, nunca espalhados pelos
/// módulos que os consomem (Frota, Usuários checam contra isso, não
/// reinventam a regra cada um do seu jeito).
model Plan {
  id          String   @id @default(uuid())
  code        String   @unique
  name        String
  maxVehicles Int? // null = sem limite
  maxUsers    Int? // null = sem limite
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  companies Company[]

  @@map("plans")
}

/// Histórico append-only de mudança de estado de uma empresa (auditoria de ciclo de vida).
model CompanyStatusEvent {
  id              String   @id @default(uuid())
  companyId       String
  company         Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  fromStatus      String?
  toStatus        String
  reason          String?
  changedByUserId String?
  createdAt       DateTime @default(now())

  @@index([companyId])
  @@map("company_status_events")
}

/// Usuário da plataforma. companyId nulo = usuário da plataforma (Super Admin).
model User {
  id           String    @id @default(uuid())
  companyId    String?
  company      Company?  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name         String
  email        String    @unique
  passwordHash String
  active       Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  lastLoginAt  DateTime?

  roles         UserRole[]
  refreshTokens RefreshToken[]
  auditLogs     AuditLog[]
  passwordResets PasswordReset[]

  @@index([companyId])
  @@map("users")
}

/// Papel (role) do sistema. Papéis do sistema (SUPER_ADMIN etc.) têm companyId nulo.
model Role {
  id        String   @id @default(uuid())
  code      String   @unique // SUPER_ADMIN, COMPANY_ADMIN, FLEET_MANAGER, AGENT, FINANCE, CLIENT
  name      String
  createdAt DateTime @default(now())

  permissions RolePermission[]
  users       UserRole[]

  @@map("roles")
}

/// Permissão granular usada pelos guards da API.
model Permission {
  id   String @id @default(uuid())
  code String @unique // ex: companies.manage, fleet.manage, finance.manage
  description String

  roles RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model UserRole {
  userId String
  roleId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}

/// Refresh tokens de sessão. O valor em si nunca é armazenado, só o hash.
model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@map("refresh_tokens")
}

/// Link de redefinição de senha ("esqueci minha senha") — token guardado com
/// hash (mesmo padrão do refresh token), uso único, expira em 1h.
model PasswordReset {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@map("password_resets")
}

/// Trilha de auditoria — toda ação sensível (login, criação de empresa, mudança de permissão etc.) gera um registro.
model AuditLog {
  id         String   @id @default(uuid())
  companyId  String?
  company    Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action     String // ex: auth.login, company.create, user.create
  entityType String?
  entityId   String?
  metadata   Json?
  ip         String?
  createdAt  DateTime @default(now())

  @@index([companyId])
  @@index([userId])
  @@index([action])
  @@map("audit_logs")
}

/// Fila de jobs assíncronos. Processada por um worker CLI acionado via systemd timer (sem Redis).
model Job {
  id          String    @id @default(uuid())
  type        String
  payload     Json
  status      String    @default("pending") // pending | processing | done | failed
  attempts    Int       @default(0)
  lastError   String?
  runAfter    DateTime  @default(now())
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([status, runAfter])
  @@map("jobs")
}

/// Veículo da frota de uma empresa.
model Vehicle {
  id              String   @id @default(uuid())
  companyId       String
  company         Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  plate           String
  renavam         String?
  chassis         String?
  brand           String
  model           String
  modelYear       Int?
  manufactureYear Int?
  color           String?
  category        String // texto livre por enquanto: economico, sedan, suv, van, luxo...
  status          String   @default("available") // available | rented | maintenance | inactive
  odometerKm      Int      @default(0)
  fuelType        String? // flex, gasolina, diesel, eletrico, hibrido
  fipeValue       Decimal? @db.Decimal(10, 2) // base pra multas indenizatórias calculadas em % da FIPE
  maintenanceIntervalKm Int? // a cada quantos km pede revisão preventiva (padrão sugerido: 10000)
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  documents Document[]
  ratePlans RatePlan[]
  contracts Contract[]
  inspections Inspection[]
  damages     Damage[]
  maintenances Maintenance[]
  claims      Claim[]
  fines       Fine[]
  positions   VehiclePosition[]
  expenses    Expense[]

  @@unique([companyId, plate])
  @@index([companyId])
  @@map("vehicles")
}

/// Cliente (locatário) de uma empresa — não é um usuário do sistema, não faz login.
model Customer {
  id                     String    @id @default(uuid())
  companyId              String
  company                Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name                   String
  document               String // CPF ou CNPJ
  documentType           String    @default("CPF") // CPF | CNPJ
  email                  String?
  phone                  String?
  birthDate              DateTime?
  address                String?
  driverLicenseNumber    String?
  driverLicenseCategory  String?
  driverLicenseExpiry    DateTime?
  // Dados bancários — usados só pra devolução de saldo de caução ao final da
  // locação. Nunca usados pra cobrança (isso é sempre cartão/manual, fora do
  // sistema); guardar aqui é só o destino de um possível reembolso.
  bankName               String?
  bankAgency             String?
  bankAccount            String?
  pixKey                 String?
  notes                  String?
  active                 Boolean   @default(true)
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  documents Document[]
  contracts Contract[]
  charges   Charge[]

  @@unique([companyId, document])
  @@index([companyId])
  @@map("customers")
}

/// Documento privado anexado a um cliente, veículo ou vistoria (CNH, CRLV, fotos etc.).
/// Nunca servido estaticamente — sempre lido e transmitido pela API após checar permissão.
model Document {
  id               String      @id @default(uuid())
  companyId        String
  company          Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  ownerType        String // CUSTOMER | VEHICLE | INSPECTION | CLAIM
  customerId       String?
  customer         Customer?   @relation(fields: [customerId], references: [id], onDelete: Cascade)
  vehicleId        String?
  vehicle          Vehicle?    @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  inspectionId     String?
  inspection       Inspection? @relation(fields: [inspectionId], references: [id], onDelete: Cascade)
  claimId          String?
  claim            Claim?      @relation(fields: [claimId], references: [id], onDelete: Cascade)
  label            String // ex: "CNH frente", "CRLV", "Foto lateral direita"
  filePath         String // relativo à raiz de uploads privados
  mimeType         String
  sizeBytes        Int
  uploadedByUserId String?
  createdAt        DateTime    @default(now())

  @@index([companyId])
  @@index([customerId])
  @@index([vehicleId])
  @@index([inspectionId])
  @@index([claimId])
  @@map("documents")
}

/// Plano de tarifa — por categoria de veículo ou específico de um veículo.
model RatePlan {
  id                String   @id @default(uuid())
  companyId         String
  company           Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name              String
  category          String? // aplica a uma categoria de veículo (se vehicleId for nulo)
  vehicleId         String? // ou é específico de um veículo
  vehicle           Vehicle? @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  dailyRate         Decimal  @db.Decimal(10, 2)
  weeklyRate        Decimal? @db.Decimal(10, 2)
  monthlyRate       Decimal? @db.Decimal(10, 2)
  kmAllowancePerDay Int?
  kmAllowancePerMonth Int? // limite mensal (modalidade motorista de app — diferente do limite diário acima)
  extraKmRate       Decimal? @db.Decimal(10, 2)
  cautionAmount     Decimal? @db.Decimal(10, 2) // valor do depósito de caução, se este plano exigir
  active            Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  contracts Contract[]

  @@index([companyId])
  @@map("rate_plans")
}

/// Contrato de locação — o núcleo da operação.
model Contract {
  id                String    @id @default(uuid())
  companyId         String
  company           Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customerId        String
  customer          Customer  @relation(fields: [customerId], references: [id])
  vehicleId         String
  vehicle           Vehicle   @relation(fields: [vehicleId], references: [id])
  ratePlanId        String?
  ratePlan          RatePlan? @relation(fields: [ratePlanId], references: [id], onDelete: SetNull)
  templateType      String    @default("standard") // standard | monthly_app_driver — qual modelo de PDF gerar
  startDate         DateTime
  endDate           DateTime
  dailyRateSnapshot Decimal   @db.Decimal(10, 2)
  totalValue        Decimal   @db.Decimal(10, 2)
  // Snapshots da modalidade "motorista de app" — copiados do RatePlan no
  // momento da criação, igual já fazemos com dailyRateSnapshot, pra o
  // contrato não mudar de valor se a tarifa for editada depois.
  monthlyKmLimitSnapshot Int?
  extraKmRateSnapshot    Decimal? @db.Decimal(10, 2)
  cautionAmountSnapshot  Decimal? @db.Decimal(10, 2)
  status            String    @default("draft") // draft | awaiting_signature | active | completed | cancelled
  deliveredAt       DateTime? // preenchido ao registrar a vistoria de entrega
  returnedAt        DateTime? // preenchido ao registrar a vistoria de devolução
  createdByUserId   String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  signature   ContractSignature?
  inspections Inspection[]
  damages     Damage[]
  claims      Claim[]
  fines       Fine[]
  charges     Charge[]

  @@index([companyId])
  @@index([customerId])
  @@index([vehicleId])
  @@map("contracts")
}

/// Sessão de assinatura interna de um contrato — link público de uso único.
/// O cliente (locatário) nunca tem login no sistema, então a assinatura
/// acontece por um token público de curta duração, não por uma sessão autenticada.
model ContractSignature {
  id              String    @id @default(uuid())
  contractId      String    @unique
  contract        Contract  @relation(fields: [contractId], references: [id], onDelete: Cascade)
  token           String    @unique
  type            String    @default("click_accept") // click_accept (outros tipos podem ser adicionados depois)
  expiresAt       DateTime
  signedAt        DateTime?
  termsHash       String? // SHA-256 dos termos exatamente como aceitos
  signerIp        String?
  signerUserAgent String?
  createdByUserId String?
  createdAt       DateTime  @default(now())

  @@map("contract_signatures")
}

/// Vistoria de entrega ou devolução de um veículo, sempre ligada a um contrato.
model Inspection {
  id                String   @id @default(uuid())
  companyId         String
  company           Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  contractId        String
  contract          Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  vehicleId         String
  vehicle           Vehicle  @relation(fields: [vehicleId], references: [id])
  type              String // delivery | return
  performedAt       DateTime @default(now())
  odometerKm        Int
  fuelLevel         String // cheio | 3/4 | 1/2 | 1/4 | reserva
  exteriorNotes     String?
  performedByUserId String?
  createdAt         DateTime @default(now())

  photos  Document[]
  damages Damage[]

  @@index([companyId])
  @@index([contractId])
  @@map("inspections")
}

/// Avaria de um veículo — encontrada numa vistoria ou registrada avulsa.
model Damage {
  id               String      @id @default(uuid())
  companyId        String
  company          Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  vehicleId        String
  vehicle          Vehicle     @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  contractId       String?
  contract         Contract?   @relation(fields: [contractId], references: [id], onDelete: SetNull)
  inspectionId     String?
  inspection       Inspection? @relation(fields: [inspectionId], references: [id], onDelete: SetNull)
  description      String
  severity         String      @default("minor") // minor | moderate | severe
  estimatedCost    Decimal?    @db.Decimal(10, 2)
  chargeToCustomer Boolean     @default(false)
  status           String      @default("open") // open | resolved
  createdByUserId  String?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  @@index([companyId])
  @@index([vehicleId])
  @@map("damages")
}

/// Registro de manutenção de um veículo — independente de contrato.
model Maintenance {
  id              String    @id @default(uuid())
  companyId       String
  company         Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  vehicleId       String
  vehicle         Vehicle   @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  type            String // preventive | corrective
  description     String
  performedAt     DateTime  @default(now())
  odometerKm      Int?
  cost            Decimal?  @db.Decimal(10, 2)
  vendor          String?
  nextDueDate     DateTime?
  nextDueKm       Int?
  createdByUserId String?
  createdAt       DateTime  @default(now())

  @@index([companyId])
  @@index([vehicleId])
  @@map("maintenances")
}

/// Sinistro (acidente, roubo/furto, incêndio etc.) envolvendo um veículo.
model Claim {
  id                    String    @id @default(uuid())
  companyId             String
  company               Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  vehicleId             String
  vehicle               Vehicle   @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  contractId            String?
  contract              Contract? @relation(fields: [contractId], references: [id], onDelete: SetNull)
  type                  String // accident | theft | fire | other
  occurredAt            DateTime
  location              String?
  description           String
  policeReportNumber    String? // número do B.O.
  thirdPartyInvolved    Boolean   @default(false)
  thirdPartyDescription String?
  insuranceClaimNumber  String?
  estimatedCost         Decimal?  @db.Decimal(10, 2)
  status                String    @default("open") // open | in_progress | resolved | closed
  createdByUserId       String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  photos Document[]

  @@index([companyId])
  @@index([vehicleId])
  @@map("claims")
}

/// Multa de trânsito — cadastro manual, sem integração com órgãos oficiais.
model Fine {
  id               String    @id @default(uuid())
  companyId        String
  company          Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  vehicleId        String
  vehicle          Vehicle   @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  contractId       String?
  contract         Contract? @relation(fields: [contractId], references: [id], onDelete: SetNull)
  infractionDate   DateTime
  dueDate          DateTime?
  amount           Decimal   @db.Decimal(10, 2)
  description      String // descrição da infração
  documentNumber   String? // número do AIT/notificação
  status           String    @default("pending") // pending | paid | contested
  chargeToCustomer Boolean   @default(false)
  createdByUserId  String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([companyId])
  @@index([vehicleId])
  @@map("fines")
}

/// Posição de rastreamento de um veículo. "source" identifica o adapter que
/// gerou o registro — hoje só "manual" existe; adapters de rastreadores reais
/// podem escrever aqui no futuro sem mudar nada no resto do sistema.
model VehiclePosition {
  id               String   @id @default(uuid())
  companyId        String
  company          Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  vehicleId        String
  vehicle          Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  latitude         Decimal? @db.Decimal(9, 6)
  longitude        Decimal? @db.Decimal(9, 6)
  locationText     String? // descrição livre, útil sem coordenadas (ex: "Pátio da matriz")
  source           String   @default("manual")
  recordedAt       DateTime @default(now())
  recordedByUserId String?

  @@index([companyId])
  @@index([vehicleId])
  @@map("vehicle_positions")
}

/// Lançamento financeiro (conta a receber). Nasce automaticamente quando um
/// contrato é assinado (aluguel) ou quando uma avaria/multa é marcada "cobrar
/// do cliente" — também pode ser criado manualmente.
model Charge {
  id              String    @id @default(uuid())
  companyId       String
  company         Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customerId      String?
  customer        Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  contractId      String?
  contract        Contract? @relation(fields: [contractId], references: [id], onDelete: SetNull)
  type            String // rental | damage | fine | other
  description     String
  amount          Decimal   @db.Decimal(10, 2)
  status          String    @default("pending") // pending | paid | cancelled
  dueDate         DateTime?
  paidAt          DateTime?
  createdByUserId String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([companyId])
  @@index([customerId])
  @@index([contractId])
  @@map("charges")
}

/// Despesa da empresa — lançamento manual (manutenção, combustível, seguro etc.).
model Expense {
  id              String   @id @default(uuid())
  companyId       String
  company         Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  vehicleId       String?
  vehicle         Vehicle? @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  category        String // maintenance | fuel | insurance | other
  description     String
  amount          Decimal  @db.Decimal(10, 2)
  incurredAt      DateTime @default(now())
  createdByUserId String?
  createdAt       DateTime @default(now())

  @@index([companyId])
  @@map("expenses")
}
