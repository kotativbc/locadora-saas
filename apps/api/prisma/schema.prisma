generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Empresa locadora cadastrada na plataforma (tenant).
model Company {
  id          String   @id @default(uuid())
  name        String
  tradeName   String?
  cnpj        String?  @unique
  logoPath    String? // caminho relativo dentro de /srv/rental-data/uploads, nunca uma URL pública direta
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users     User[]
  auditLogs AuditLog[]
  vehicles  Vehicle[]
  customers Customer[]
  documents Document[]
  ratePlans RatePlan[]
  contracts Contract[]

  @@map("companies")
}

/// Usuário da plataforma. companyId nulo = usuário da plataforma (Super Admin).
model User {
  id           String    @id @default(uuid())
  companyId    String?
  company      Company?  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name         String
  email        String    @unique
  passwordHash String
  active       Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  lastLoginAt  DateTime?

  roles         UserRole[]
  refreshTokens RefreshToken[]
  auditLogs     AuditLog[]

  @@index([companyId])
  @@map("users")
}

/// Papel (role) do sistema. Papéis do sistema (SUPER_ADMIN etc.) têm companyId nulo.
model Role {
  id        String   @id @default(uuid())
  code      String   @unique // SUPER_ADMIN, COMPANY_ADMIN, FLEET_MANAGER, AGENT, FINANCE, CLIENT
  name      String
  createdAt DateTime @default(now())

  permissions RolePermission[]
  users       UserRole[]

  @@map("roles")
}

/// Permissão granular usada pelos guards da API.
model Permission {
  id   String @id @default(uuid())
  code String @unique // ex: companies.manage, fleet.manage, finance.manage
  description String

  roles RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model UserRole {
  userId String
  roleId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}

/// Refresh tokens de sessão. O valor em si nunca é armazenado, só o hash.
model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@map("refresh_tokens")
}

/// Trilha de auditoria — toda ação sensível (login, criação de empresa, mudança de permissão etc.) gera um registro.
model AuditLog {
  id         String   @id @default(uuid())
  companyId  String?
  company    Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action     String // ex: auth.login, company.create, user.create
  entityType String?
  entityId   String?
  metadata   Json?
  ip         String?
  createdAt  DateTime @default(now())

  @@index([companyId])
  @@index([userId])
  @@index([action])
  @@map("audit_logs")
}

/// Fila de jobs assíncronos. Processada por um worker CLI acionado via systemd timer (sem Redis).
model Job {
  id          String    @id @default(uuid())
  type        String
  payload     Json
  status      String    @default("pending") // pending | processing | done | failed
  attempts    Int       @default(0)
  lastError   String?
  runAfter    DateTime  @default(now())
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([status, runAfter])
  @@map("jobs")
}

/// Veículo da frota de uma empresa.
model Vehicle {
  id              String   @id @default(uuid())
  companyId       String
  company         Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  plate           String
  renavam         String?
  chassis         String?
  brand           String
  model           String
  modelYear       Int?
  manufactureYear Int?
  color           String?
  category        String // texto livre por enquanto: economico, sedan, suv, van, luxo...
  status          String   @default("available") // available | rented | maintenance | inactive
  odometerKm      Int      @default(0)
  fuelType        String? // flex, gasolina, diesel, eletrico, hibrido
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  documents Document[]
  ratePlans RatePlan[]
  contracts Contract[]

  @@unique([companyId, plate])
  @@index([companyId])
  @@map("vehicles")
}

/// Cliente (locatário) de uma empresa — não é um usuário do sistema, não faz login.
model Customer {
  id                     String    @id @default(uuid())
  companyId              String
  company                Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name                   String
  document               String // CPF ou CNPJ
  documentType           String    @default("CPF") // CPF | CNPJ
  email                  String?
  phone                  String?
  birthDate              DateTime?
  address                String?
  driverLicenseNumber    String?
  driverLicenseCategory  String?
  driverLicenseExpiry    DateTime?
  notes                  String?
  active                 Boolean   @default(true)
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  documents Document[]
  contracts Contract[]

  @@unique([companyId, document])
  @@index([companyId])
  @@map("customers")
}

/// Documento privado anexado a um cliente ou veículo (CNH, CRLV, RG etc.).
/// Nunca servido estaticamente — sempre lido e transmitido pela API após checar permissão.
model Document {
  id               String    @id @default(uuid())
  companyId        String
  company          Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  ownerType        String // CUSTOMER | VEHICLE
  customerId       String?
  customer         Customer? @relation(fields: [customerId], references: [id], onDelete: Cascade)
  vehicleId        String?
  vehicle          Vehicle?  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  label            String // ex: "CNH frente", "CRLV", "RG"
  filePath         String // relativo à raiz de uploads privados
  mimeType         String
  sizeBytes        Int
  uploadedByUserId String?
  createdAt        DateTime  @default(now())

  @@index([companyId])
  @@index([customerId])
  @@index([vehicleId])
  @@map("documents")
}

/// Plano de tarifa — por categoria de veículo ou específico de um veículo.
model RatePlan {
  id                String   @id @default(uuid())
  companyId         String
  company           Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name              String
  category          String? // aplica a uma categoria de veículo (se vehicleId for nulo)
  vehicleId         String? // ou é específico de um veículo
  vehicle           Vehicle? @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  dailyRate         Decimal  @db.Decimal(10, 2)
  weeklyRate        Decimal? @db.Decimal(10, 2)
  monthlyRate       Decimal? @db.Decimal(10, 2)
  kmAllowancePerDay Int?
  extraKmRate       Decimal? @db.Decimal(10, 2)
  active            Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  contracts Contract[]

  @@index([companyId])
  @@map("rate_plans")
}

/// Contrato de locação — o núcleo da operação.
model Contract {
  id                String    @id @default(uuid())
  companyId         String
  company           Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customerId        String
  customer          Customer  @relation(fields: [customerId], references: [id])
  vehicleId         String
  vehicle           Vehicle   @relation(fields: [vehicleId], references: [id])
  ratePlanId        String?
  ratePlan          RatePlan? @relation(fields: [ratePlanId], references: [id], onDelete: SetNull)
  startDate         DateTime
  endDate           DateTime
  dailyRateSnapshot Decimal   @db.Decimal(10, 2)
  totalValue        Decimal   @db.Decimal(10, 2)
  status            String    @default("draft") // draft | awaiting_signature | active | completed | cancelled
  createdByUserId   String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  signature ContractSignature?

  @@index([companyId])
  @@index([customerId])
  @@index([vehicleId])
  @@map("contracts")
}

/// Sessão de assinatura interna de um contrato — link público de uso único.
/// O cliente (locatário) nunca tem login no sistema, então a assinatura
/// acontece por um token público de curta duração, não por uma sessão autenticada.
model ContractSignature {
  id              String    @id @default(uuid())
  contractId      String    @unique
  contract        Contract  @relation(fields: [contractId], references: [id], onDelete: Cascade)
  token           String    @unique
  type            String    @default("click_accept") // click_accept (outros tipos podem ser adicionados depois)
  expiresAt       DateTime
  signedAt        DateTime?
  termsHash       String? // SHA-256 dos termos exatamente como aceitos
  signerIp        String?
  signerUserAgent String?
  createdByUserId String?
  createdAt       DateTime  @default(now())

  @@map("contract_signatures")
}
